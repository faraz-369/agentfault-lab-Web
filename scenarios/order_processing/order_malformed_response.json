{
  "scenario_id": "order_malformed_response",
  "name": "Order update with malformed response",
  "description": "The update commits, but the tool returns a malformed response. Compare blind retry with state-aware recovery.",
  "task": "Validate an order, update its status, send a notification, and mark the workflow complete.",
  "initial_state": {
    "orders": {
      "order-1": {
        "status": "new",
        "updates": 0
      }
    },
    "actions": [
      {
        "tool": "validate_order",
        "args": {
          "order_id": "order-1"
        }
      },
      {
        "tool": "update_order_status",
        "args": {
          "order_id": "order-1",
          "status": "processed",
          "operation_id": "update-order-1"
        }
      },
      {
        "tool": "send_notification",
        "args": {
          "operation_id": "notify-order-1"
        }
      },
      {
        "tool": "mark_complete",
        "args": {}
      }
    ],
    "expected_final_state": {
      "completed": true
    }
  },
  "fault": {
    "fault_id": "malformed-update-response",
    "kind": "malformed",
    "tool_name": "update_order_status",
    "trigger_call_number": 1,
    "message": "simulated truncated response",
    "repeat": false
  },
  "invariants": [
    {
      "invariant_id": "unique-state-operation",
      "description": "A state-changing operation identifier must not be committed more than once.",
      "kind": "unique_operation",
      "params": {}
    },
    {
      "invariant_id": "completed-final-state",
      "description": "Successful execution must end in completed state.",
      "kind": "no_false_completion",
      "params": {
        "required_state_field": "completed",
        "equals": true
      }
    }
  ],
  "max_steps": 10,
  "max_tool_calls": 30,
  "tags": [
    "fault-injection",
    "state-aware-recovery",
    "regression"
  ]
}