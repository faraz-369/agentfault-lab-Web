# Public URL of the deployed FastAPI service, without a trailing slash.
AGENTFAULT_API_URL=https://your-agentfault-api.onrender.com

# Must match the AGENTFAULT_API_KEY configured on the backend service.
# Keep this server-only: do not prefix it with NEXT_PUBLIC_.
AGENTFAULT_API_KEY=replace-with-the-backend-secret
